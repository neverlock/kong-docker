# Kong Gateway Enterprise
KONG_VERSION=3.16.0.3
KONG_PROXY_HTTP_PORT=80
KONG_PROXY_HTTPS_PORT=443
KONG_ADMIN_PORT=8001
KONG_MANAGER_PORT=8002
TZ=Asia/Bangkok

# Export KONG_LICENSE_DATA with a valid Enterprise license to enable writes.

# PostgreSQL. Keep the PostgreSQL major version in sync with ./pg_data.
POSTGRES_VERSION=17-alpine
POSTGRES_USER=kong
POSTGRES_PASSWORD=kong
POSTGRES_DB=kong
