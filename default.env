# Kong Gateway Community Edition
KONG_CE_VERSION=3.9.5
KONG_PROXY_HTTP_PORT=80
KONG_PROXY_HTTPS_PORT=443
KONG_ADMIN_PORT=8001
KONG_MANAGER_PORT=8002
TZ=Asia/Bangkok

# PostgreSQL. Keep the major version in sync with the data directory.
POSTGRES_VERSION=17-alpine
POSTGRES_DATA_DIR=./kong_ce_data
POSTGRES_USER=kong
POSTGRES_PASSWORD=kong
POSTGRES_DB=kong
